# Booking API base for the server-side rewrite (NOT exposed to the browser).
# Local docker app container maps host :4000 -> container :3000.
BOOKING_API_URL=http://localhost:4000

# Same-origin API: leave empty so the browser calls /v1.0/* on this app's own
# origin and Next proxies to BOOKING_API_URL. Set to a full URL only if you
# want the browser to hit the API directly (then CORS must be handled).
NEXT_PUBLIC_API_URL=

# Low-privilege platform bootstrap key (ApiClient: client_regular, no enterprise).
# Its ONLY job is to authorize POST /v1.0/auth/token. All admin authority comes
# from the atlantes_admin account scope after login — never from this key.
# Generate with: atl-booking-api/scripts/seedAtlantesAdmin.ts
NEXT_PUBLIC_ADMIN_API_KEY_ID=
NEXT_PUBLIC_ADMIN_API_KEY_SECRET=
